  {
   "id": "c-void",
   "type": "classe",
   "min": 10,
   "max": 12,
   "zone": "Ironforge → Ventobravo",
   "title": "Gakin's Summons",
   "pt": "Missão do Voidwalker",
   "where": "Lago Blackwrench (Ironforge) → Gakin the Darkbinder, porão do Slaughtered Lamb",
   "steps": [
    "Surena Caledon: mate-a no Brackwell Pumpkin Patch (Elwynn, 70.8 80.2). Nível 9, com dois guardas.",
    "The Binding: use o Bloodstone Choker no círculo abaixo da sala do Gakin e derrote o Voidwalker."
   ],
   "reward": {
    "text": "Summon Voidwalker"
   },
   "why": "Tanque para pulls perigosos. No Forever o colar é loot de grupo: dois bruxos saem com um cada.",
   "src": "https://conquestcapped.com/guides/wow-forever/wow-forever-warlock-quests/"
  },
  {
   "id": "c-sayaad",
   "type": "classe",
   "min": 20,
   "max": 24,
   "zone": "Barrens → Ashenvale → Ventobravo",
   "title": "Devourer of Souls",
   "pt": "Succubus ou Incubus",
   "where": "Gakin (Ventobravo) → Takar the Seer, The Barrens (49.2 57.0)",
   "steps": [
    "Succubus: pegue o Heartswood nas raízes em Ordil'Aran, Ashenvale (31.4 31.5).",
    "Incubus: \"What Is Love?\" — roube a Wooden Figurine numa casa em Ashenvale (26.0 22.0).",
    "The Binding: no círculo do Slaughtered Lamb (39.0 84.5), derrote o demônio."
   ],
   "reward": {
    "text": "Succubus ou Incubus + Small Soul Pouch"
   },
   "why": "O demônio de maior dano. Os grimórios de um não servem no outro.",
   "src": "https://conquestcapped.com/guides/wow-forever/wow-forever-warlock-quests/"
  },
  {
